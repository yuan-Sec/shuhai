{
  "name": "ebook-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "build:full": "vite build && node scripts/postbuild.mjs && npx cap sync android",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^4.8.2",
    "@capacitor/core": "^4.8.2",
    "@capacitor/filesystem": "^4.1.5",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^4.8.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "7.3.6"
  }
